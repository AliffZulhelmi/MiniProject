# Capture evidence can become large and may include sensitive network metadata.
data/raw_pcaps/*
data/exports/*
data/logs/*
data/evidence/*
!data/raw_pcaps/.gitkeep
!data/exports/.gitkeep
!data/logs/.gitkeep
!data/evidence/.gitkeep

# Keep small curated sample captures only when intentionally added.
data/sample_pcaps/*
!data/sample_pcaps/README.md
